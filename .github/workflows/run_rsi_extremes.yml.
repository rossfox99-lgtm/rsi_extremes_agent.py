name: Execute Daily RSI Extreme Scan

on:
  schedule:
    # Runs automatically Monday through Friday at 21:30 UTC (5:30 PM EST / 4:30 PM CST)
    - cron: '30 21 * * 1-5'
  workflow_dispatch: # Keeps your manual play button active

jobs:
  run-extremes-scanner:
    runs-with: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'
          cache: 'pip'

      - name: Install Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install yfinance pandas numpy requests lxml openpyxl google-genai

      - name: Run Climax Script
        env:
          DISCORD_WEBHOOK: ${{ secrets.DISCORD_WEBHOOK }}
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
        run: python rsi_extremes_agents.py
